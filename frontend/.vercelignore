# Vercel ignore file for frontend deployment

# Development files
*.log
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node modules (not applicable for static site but good practice)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
Thumbs.db
.Spotlight-V100
.Trashes
ehthumbs.db

# Temporary files
*.tmp
*.temp